    "happy-dom": "^15.11.7",
    "prettier": "3.6.2",
    "typescript": "~5.6",
    "typescript-eslint": "^8.61.1",
    "vite": "^7.0.6",
    "vite-plugin-cesium": "^1.2.23",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.12"
