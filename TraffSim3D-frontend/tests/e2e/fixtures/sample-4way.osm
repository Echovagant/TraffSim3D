<?xml version="1.0" encoding="UTF-8"?>
<osm version="0.6" generator="plan-041-test">
  <!-- 4-way intersection at (0,0) with traffic signals.
       NS road = residential, EW road = residential.
       East arm (r-ew-east) has bridge=yes -> level=1. -->

  <!-- Nodes: 4 corners + 4 mid-arm + center + 2 east-arm nodes -->
  <node id="1" lat="0.0000" lon="-0.0010" />
  <node id="2" lat="0.0000" lon="-0.0005" />
  <node id="3" lat="0.0000" lon="0.0000" />
  <node id="4" lat="0.0000" lon="0.0005" />
  <node id="5" lat="0.0000" lon="0.0010" />
  <node id="6" lat="-0.0010" lon="0.0000" />
  <node id="7" lat="0.0010" lon="0.0000" />
  <node id="8" lat="0.0000" lon="0.0015" />
  <node id="9" lat="0.0000" lon="0.0020" />

  <!-- Center node: shared by 3 ways + tagged traffic_signals -->
  <node id="3" lat="0.0000" lon="0.0000">
    <tag k="highway" v="traffic_signals" />
  </node>

  <!-- NS road: north arm (1-3) + south arm (3-7). Shared node = 3 (center). -->
  <way id="201">
    <nd ref="1" />
    <nd ref="2" />
    <nd ref="3" />
    <nd ref="6" />
    <nd ref="7" />
    <tag k="highway" v="residential" />
    <tag k="lanes" v="4" />
    <tag k="name" v="NS Main" />
  </way>

  <!-- EW west arm: 1-3-5. (One-way for testing oneway handling.)
       Actually use bidirectional for clarity. -->
  <way id="202">
    <nd ref="5" />
    <nd ref="4" />
    <nd ref="3" />
    <tag k="highway" v="residential" />
    <tag k="lanes" v="2" />
  </way>

  <!-- EW east arm with bridge=yes (should get level=1). -->
  <way id="203">
    <nd ref="3" />
    <nd ref="4" />
    <nd ref="5" />
    <nd ref="8" />
    <nd ref="9" />
    <tag k="highway" v="residential" />
    <tag k="lanes" v="2" />
    <tag k="bridge" v="yes" />
    <tag k="name" v="EW East Bridge" />
  </way>

  <!-- One-way service road to verify oneway handling. -->
  <way id="204">
    <nd ref="7" />
    <nd ref="8" />
    <nd ref="9" />
    <tag k="highway" v="service" />
    <tag k="lanes" v="4" />
    <tag k="oneway" v="yes" />
  </way>

  <!-- Unrecognized highway type — should be skipped. -->
  <way id="205">
    <nd ref="1" />
    <nd ref="6" />
    <tag k="highway" v="footway" />
  </way>
</osm>