# TraffSim3D frontend — local dev environment template.
# Copy to .env.local and uncomment / edit what you need.
#
# Why .env.local: Vite reads it automatically; it's git-ignored so you
# won't accidentally commit personal overrides.

# --- Backend port (default 8000) -----------------------------------------
# Set this to the port your uvicorn is listening on. Both the vite proxy
# (vite.config.js → /api) and MapImporterView's direct upload fetch use
# this value, so they stay in sync.
#
# Examples:
#   VITE_BACKEND_PORT=8000   # default — `uv run uvicorn app.main:app`
#   VITE_BACKEND_PORT=11717  # user on a custom port (legacy sessions)

VITE_BACKEND_PORT=8000

# --- Backend URL (advanced, overrides the port) ---------------------------
# If your backend lives at a non-localhost URL (LAN dev, staging, etc.),
# set the full URL here. Takes precedence over VITE_BACKEND_PORT.
# Leave commented for the default localhost setup.
#
# VITE_BACKEND_URL=http://192.168.1.50:8000
