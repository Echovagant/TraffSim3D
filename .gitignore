# RL engine runtime state (PPO checkpoints, training status, pause/terminate
# control file). Deliberately anchored to TraffSim3D-backend/ instead of /tmp —
# on Windows /tmp is drive-relative, which split checkpoints across drives.
# See TraffSim3D-backend/app/apps/rl/paths.py.
TraffSim3D-backend/.data/

# Node (TraffSim3D-frontend)
node_modules/
dist/
dist-ssr/
*.local

# Coverage / test artifacts
coverage/
.nyc_output/
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Playwright e2e + screenshot baselines
e2e-output/current/
e2e-output/perf/
TraffSim3D-frontend/test-results/
TraffSim3D-frontend/playwright-report/
TraffSim3D-frontend/playwright.perf.config.ts
TraffSim3D-frontend/playwright.local.config.ts
# Generated by the CI e2e job on the fly (it moves the frontend to :5188).
# The workflow writes it at run time, so a local run of the same command
# would leave an untracked file behind.
TraffSim3D-frontend/playwright.ci.config.ts

# Cross-language contract test snapshots.
# The Python side regenerates its own on every run; the TS side's goldens# are committed so the backend suite can run the full contract standalone.
TraffSim3D-backend/tests/contract/snapshots/python_*.json

# Overpass response cache (large JSON files regenerated
# by the backend; user can `rm -rf` to force refresh from overpass-api.de)
TraffSim3D-backend/geojson/cache/

# Real-world map data files (large, downloaded/regenerable, not source):
# keep geojson2osm.py tool but ignore the .geojson / .osm data blobs
TraffSim3D-backend/geojson/*.geojson
TraffSim3D-backend/geojson/*.osm

# Third-party reference repos cloned into root (not part of this project)
gsap-skills/

# Root-level Playwright test-results (in addition to the frontend-specific
# path above; some runs write to project root)
/test-results/

# Local tooling scratch dirs
.qoder-cn/

# Analysis report scratch (regenerated on demand)
1014分析报告.md

# --- Local-only working material (never published) ---------------------------
