    "/api/v1/maps/parse-osm": {
      "post": {
        "tags": [
          "maps",
          "maps"
        ],
        "summary": "Parse Osm",
        "description": "Parse an uploaded .osm file into a RoadNetwork dict.\n\nOptional bbox query params (south, west, north, east) clip the map to an\narea of interest; omit them all to keep the parser's default\n~55 km memory-safety cap. The response shape is identical either way.",
        "operationId": "parse_osm_api_v1_maps_parse_osm_post",
        "parameters": [
          {
            "name": "south",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 90,
                  "minimum": -90
                },
                {
                  "type": "null"
                }
              ],
              "title": "South"
            }
          },
          {
            "name": "west",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 180,
                  "minimum": -180
                },
                {
                  "type": "null"
                }
              ],
              "title": "West"
            }
          },
          {
            "name": "north",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 90,
                  "minimum": -90
                },
                {
                  "type": "null"
                }
              ],
              "title": "North"
            }
          },
          {
            "name": "east",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 180,
                  "minimum": -180
                },
                {
                  "type": "null"
                }
              ],
              "title": "East"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_parse_osm_api_v1_maps_parse_osm_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Parse Osm Api V1 Maps Parse Osm Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/maps/parse-pbf": {
      "post": {
        "tags": [
          "maps",
          "maps"
        ],
        "summary": "Parse Pbf",
        "description": "Parse an uploaded .osm.pbf file into a RoadNetwork dict.\n\nSame return shape as /maps/parse-osm. Uses libosmium (osmium Python\nbindings) to stream the binary PBF. Real-world city files (Shenzhen\n~20MB, Guangdong ~200MB) use this format.\n\nTakes the same optional bbox query params as /maps/parse-osm.",
        "operationId": "parse_pbf_api_v1_maps_parse_pbf_post",
        "parameters": [
          {
            "name": "south",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 90,
                  "minimum": -90
                },
                {
                  "type": "null"
                }
              ],
              "title": "South"
            }
          },
          {
            "name": "west",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 180,
                  "minimum": -180
                },
                {
                  "type": "null"
                }
              ],
              "title": "West"
            }
          },
          {
            "name": "north",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 90,
                  "minimum": -90
                },
                {
                  "type": "null"
                }
              ],
              "title": "North"
            }
          },
          {
            "name": "east",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 180,
                  "minimum": -180
                },
                {
                  "type": "null"
                }
              ],
              "title": "East"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_parse_pbf_api_v1_maps_parse_pbf_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Parse Pbf Api V1 Maps Parse Pbf Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/maps/overpass": {
      "get": {
        "tags": [
          "maps",
          "maps"
        ],
        "summary": "Overpass",
        "description": "Plan 056: cached Overpass proxy.\n\nThe smart-city view (Plan 055) used to call Overpass directly,\nwhich fails in China (overpass-api.de is blocked) and re-fetches\non every page load. This endpoint forwards the query to Overpass\nonce, caches the response to `geojson/cache/<hash>.json`, and\nserves subsequent identical queries from disk.\n\nQuery param:\n  `query` — the full Overpass QL string (e.g. `[out:json][timeout:60]; ...`)\n\nReturns:\n  The raw Overpass JSON dict (`{ version, generator, elements }`).",
        "operationId": "overpass_api_v1_maps_overpass_get",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 10,
              "title": "Query"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Overpass Api V1 Maps Overpass Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/maps/overpass/cache": {
      "get": {
        "tags": [
