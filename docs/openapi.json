    "/api/v1/rl/checkpoints/{name}/weights": {
      "get": {
        "tags": [
          "rl",
          "rl"
        ],
        "summary": "Get Checkpoint Weights",
        "description": "Plan 049: export a saved PPO checkpoint as JSON-serializable weights.\n\nThe frontend uses this to instantiate an in-browser MlpPolicy for\nreplay (see `src/infrastructure/rl/mlpInference.ts`). Returns the\npolicy `state_dict()` flattened to nested lists + architecture\nmetadata (`obs_dim`, `action_dim`, `hidden_sizes`).\n\nErrors:\n  - 404: checkpoint file not found\n  - 503: SB3 / torch not installed (run `uv sync --extra rl`)",
        "operationId": "get_checkpoint_weights_api_v1_rl_checkpoints__name__weights_get",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "responses": {
