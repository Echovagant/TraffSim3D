    "/api/v1/maps/overpass": {
      "get": {
        "tags": [
          "maps",
          "maps"
        ],
        "summary": "Overpass",
        "description": "Cached Overpass proxy.\n\nThe smart-city view used to call Overpass directly,\nwhich is unreachable from some networks (overpass-api.de is blocked) and re-fetches\non every page load. This endpoint forwards the query to Overpass\nonce, caches the response to `geojson/cache/<hash>.json`, and\nserves subsequent identical queries from disk.\n\nQuery param:\n  `query` — the full Overpass QL string (e.g. `[out:json][timeout:60]; ...`)\n\nReturns:\n  The raw Overpass JSON dict (`{ version, generator, elements }`).",
        "operationId": "overpass_api_v1_maps_overpass_get",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 10,
              "title": "Query"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Overpass Api V1 Maps Overpass Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
