  "settings": {
    "files.eol": "\n",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "[python]": {
      "editor.defaultFormatter": "ms-python.black-formatter",
      "editor.tabSize": 4
    },
    "[vue]": {
      "editor.defaultFormatter": "Vue.volar"
    }
  },
  "extensions": {
    "recommendations": [
      "Vue.volar",
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ms-python.black-formatter",
      "ms-azuretools.vscode-docker",
      "tamasfe.even-better-toml"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [],
    "compounds": []
  },
  "claude": {
    "_comment": "Project-level Claude Code metadata (custom, not VS Code standard). Read by Skill commands when they need to know which skills/mcps are wired for this repo.",
    "config_file": ".claude/CLAUDE.md",
    "settings_file": ".claude/settings.json",
    "skills_dir": ".claude/skills",
    "active_skills": [
      "improve",
      "verify",
      "code-review",
      "simplify",
      "specify",
      "plan",
      "tasks",
      "implement",
      "self-improving",
      "improve-m2",
      "sync-plans-docs",
      "e2e-review"
